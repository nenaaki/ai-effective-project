classes: {
  command: {
    style: {
      fill: "#ffff88"
    }
  }
  ai-effective-weak: {
    style: {
      fill: "#ffcccc"
    }
  }
  ai-effective: {
    style: {
      fill: "#ff8888"
    }
  }
  ai-effective-strong: {
    style: {
      fill: "#cc4444"
      stroke: "#990000"
      stroke-width: 2
    }
  }
  cost-cut: {
    label: "コストへの影響"
    style: {
      stroke: "#990000"
      stroke-width: 4
    }
  }
  person: {
    shape: person
    style: {
      stroke: "blue"
      fill: "#aaffff"
    }
  }
  ai: {
    shape: person
    style: {
      stroke: "#6a1b9a"
      fill: "#f3e5f5"
    }
  }
  ai-field: {
    label: ""
    style: {
      stroke-width: 0
      fill: "#ffffff"
    }
  }
  field: {
    label: ""
    style: {
      stroke-width: 0
      fill: "#ffffff"
    }
  }

  spec: {
    style: {
      fill: "#fef3c7"
      stroke: "#d97706"
      stroke-width: 2
    }
  }
  agent: {
    style: {
      fill: "#e0e7ff"
      stroke: "#4f46e5"
      stroke-width: 2
    }
  }
  output: {
    style: {
      fill: "#f0fdf4"
      stroke: "#16a34a"
      stroke-width: 2
    }
  }
  human: {
    style: {
      fill: "#f1f5f9"
      stroke: "#475569"
    }
  }
}

grid-rows: 3

description: ||md
  # spec駆動開発(設計～実装・単体テスト)の効果分析
||

agents: spec駆動開発 {
  direction: right
  cost-cut: {
    class: cost-cut
    description: ||md
      # spec駆動開発の効果の計算(凡例)
      - 効果のレベルを5種類に区別する
        - **省略** : AIエージェントの導入により、省略される工程( **工数削減: 100%** )
        - **AI(要レビュー)** : AIエージェントの導入により、成果物に対するレビューのみ必要となるもの( **工数削減: 90%**)
        - **AI(対話)** : AIエージェントの導入により、エンジニアの手作業をほぼ肩代わりできるもの( **工数削減: 80%** )
        - **AI(一部手作業)** : AIエージェントの導入により、手作業はなくならないが工数を削減できるもの( **工数削減: 50%** )
        - (記載せず) : AIエージェント・AIアシスタントを導入してもエンジニアの工数が削減できないもの( **工数削減: 0%** )
      - 作業難易度
        - 自動化👑
        - ベテラン向け⭐⭐⭐
        - 初級者可⭐
      ||
  }

  # 人間系
  UserZone: 人間系 {
    style: {
      stroke-dash: 5
    }
    U: プロダクトオーナー\nエンジニアなど {
      shape: person
      class: human
    }
  }

  # 核となる仕様
  spec: "仕様書\n(プランニング処理にとってのSSOT)" {
    shape: cylinder
    class: spec
  }

  # AIエージェント群
  ai-orchestrator: AIエージェント群 {
    style: {
      fill: "#f8fafc"
    }

    # 計画フェーズ
    planning: プランニング {
      style: {
        stroke-dash: 5
      }
      architect: アーキテクトAI { class: agent }
      planner: プランナーAI { class: agent }

      # 計画フェーズ: 分析 → タスク化
      architect -> planner: analysis.md
    }

    task: "タスク\n(実装処理にとってのSSOT" {
      shape: cylinder
      class: spec
    }

    planning.planner -> task: タスク化
    task -> build: タスク引き渡し

    # 設計・実装フェーズ
    build: 設計・実装 {
      style: {
        stroke-dash: 5
      }

      # 実行指揮
      orchestrator: オーケストレーターAI { class: agent }

      # 実装エージェント
      coder: 実装エージェント群 {
        db-architect: DBアーキテクトAI { class: agent }
        backend: バックエンドAI { class: agent }
        frontend: フロントエンドAI { class: agent }
      }

      # レビュー・テスト
      reviewer: バックエンドレビュワーAI { class: agent }
      tester: テスターAI { class: agent }

      # オーケストレーターによる連鎖呼び出し
      orchestrator -> coder: 順次起動
      orchestrator -> reviewer: レビュー依頼
      orchestrator -> tester: テスト依頼

      # 実装エージェント間のデータ受け渡し
      coder.db-architect -> coder.backend: schema.prisma
      coder.backend -> coder.frontend: API / DTO

      # レビュー・テストループ
      coder.backend -> reviewer: 実装コード
      reviewer -> coder.backend: 指摘・差戻し
      coder -> tester: 実装一式
      tester -> orchestrator: 結果 / 不具合レポート
    }

    # 実行フェーズへの引き渡し
    planning.planner -> build.orchestrator: 親タスク (Backlog)
    planning.architect -> build.orchestrator: analysis.md
  }

  # アウトプット (CI/CD)
  cd-ci: アウトプット {
    Prod: プロダクトコード { class: output }
    Doc: 技術ドキュメント\nテスト結果 { class: output }
  }

  # インタラクション（接続関係）
  UserZone.U -> spec: 仕様定義/プロンプト
  spec <-> ai-orchestrator.planning.planner: コンテキスト参照/更新
  spec <-> ai-orchestrator.planning.architect: コンテキスト参照/更新

  ai-orchestrator.build.coder -> cd-ci.Prod: 最終コード
  ai-orchestrator.build.tester -> cd-ci.Doc: レポート

  cd-ci.Prod -> UserZone: デプロイ {
    style: { stroke-dash: 3 }
  }
  cd-ci.Doc -> UserZone: レビュー {
    style: { stroke-dash: 3 }
  }
}

dev: {
  class: field
  grid-columns: 6
  grid-gap: 0

  requirement: {
    direction: right
    label: "要求"
    development {
      label: "要求開発"
    }
    management {
      label: "要求管理"
    }
  }
  specification: {
    label: "要件・仕様定義"
    detail: {
      label: ""
      grid-rows: 2
      grid-gap: 0
      style: {
        fill: white
        stroke-width: 0
      }
      ipo: {
        label: ""
        style: {
          fill: transparent
          stroke-width: 0
        }

        # 入力: 資料群
        input: 入力資料 {
          initial-docs: {
            label: "初期資料\n\n(データ構造資料 / ラフスケッチ / 機能一覧)"
          }
          change-docs: {
            label: "変更管理文書"
          }
          defects: {
            label: "不具合対応\n\n(運用フィードバック / 障害レポート)"
          }
          memo: ||md
            - 入力資料の準備については、従来の要件定義・仕様定義のプロセス・工数と何ら変わるところはない
          ||
        }

        # AIによる分析・タスク化
        planning: {
          label: プランニング系AIエージェントの処理
          architect: アーキテクトAI {
            class: agent
          }
          planner: プランナーAI {
            class: agent
            description: ||md
              - 新規機能の場合は親タスクを起票する
              - 既存タスクがある場合は更新する
              - 変更管理・障害対応は個別のタスクを起票する
            ||
          }
          architect -> planner: 仕様の分析結果
        }

        # 出力 (マネージャ向け)
        output: アウトプット {
          backlog: {
            style.multiple: true

            label: "親タスク群 (Backlog)"
          }
        }

        manual: {
          label: "エンジニアの判断"
          description: ||md
            - CRUD系のタスクは全てspec駆動にする
            - それ以外はAI支援型の開発にする
          ||
        }

        sdd {
          label: "spec駆動開発"
          description: ||md
            - 実装系AIエージェントによってタスクの実装を自動化する
          ||
        }
        ai-assist {
          label: "AI支援開発"
          description: ||md
            - AI支援ありの手動開発
            - 個々のAIエージェントを利用することは可能
            - タスクの粒度や内容をエンジニアが調整する
          ||
        }
        manual -> sdd: "spec駆動する範囲"
        manual -> ai-assist: "AI支援する範囲"

        cost-cut: {
          class: cost-cut
          label: 「要件定義を基にした分析・タスク化」の工数削減効果
          description: ||md
            # 定量的に削減できる工数
            - 要件・仕様定義自体はここに含まない

            ## 入力の物量的な割合
            - **初期資料**: 60% (新規開発の主体、初期に集中)
            - **変更管理**: 25% (継続的に発生)
            - **不具合対応**: 15% (運用段階で発生)

            ## AI 駆動 / AI 支援による工数影響
            | 項目 | 割合 | AI効果種類 | 工数への影響 |
            |-|-|-|-|
            | 初期資料の分析・ドメインモデル化・タスク化 | 60% | AI(一部手作業) | 50%減 |
            | 変更管理対応 (既存実装との整合確認が必要、AI支援寄り) | 25% | AI(一部手作業) | 50%減 |
            | 不具合対応 (影響範囲特定が複雑、AI支援寄り) | 15% | AI(一部手作業) | 50%減 |
            | **割合×工数への影響の合計** | 100% | - | **約 50%減** |

            ### 注記
            - 上記比率は一般的なプロジェクトを想定した概算
            - プロジェクト特性 (新規開発比率 / 運用フェーズ比率) で大きく変動する
          ||
        }

        # 接続関係
        input.initial-docs -> planning.architect: 初期資料投入時
        input.change-docs -> planning.architect: 変更発生時
        input.defects -> planning.architect: 不具合発生時

        planning.planner -> output.backlog

        output -> manual

        # スタイリング
        input: { style.fill: "#e1f5fe" }
        planning: { style.fill: "#fff3e0" }
        output: { style.fill: "#e8f5e9" }
      }
    }
  }
  design: {
    direction: right
    label: "設計"
    cost-cut: {
      class: cost-cut
      label: 設計全体のコストへの影響
      description: ||md
        # 定量的に削減できる工数
        | 項目 | 割合 | 工数への影響 |
        |-|-|-|
        | 環境構築 | 5% | 70% |
        | タスク | 5% | 100% |
        | フロントエンド | 40% | 50% |
        | データモデル | 10% | 80% |
        | バックエンド - サービス | 20% | 86% |
        | バックエンド - データベース | 10% | 90% |
        | バックエンド - インフラ | 10% | 80% |
        | **割合×工数への影響の合計** | 100% | **70.7%減** |
      ||
    }

    task: {
      label: "設計・実装タスク管理"
      task-detailed: {
        label: "タスク"
        class: ai-effective
        tooltip: "自動化👑"
        tooltip.near: top-right
        cost-cut: {
          class: cost-cut
          description: ||md
            ## 対象となる作業
            - エピック、ストーリー、フィーチャーを個別のタスクにする
              - 従来 : 担当エンジニアへの割り当て
                - タスクをチケット化する
              - 変化 : AIエージェントに向けたタスクとして切り出す
                - リポジトリ上に一時的に出力して、タスクを終えたら削除する
                - 永続的な文書はチケットに残す
            ## 定量的に削減できる工数
            | AI効果種類 | 工数割合 | 削減効果 |
            |-|-|-|
            | 省略 | 100% | 100% |
            | **割合×工数への影響の合計** | 100% | **100%減** |
          ||
        }
      }
    } 
    task -> frontend
    task -> backend
    task -> develop-env

    frontend {
      label: "フロントエンド"
      class: ai-effective-weak
      tooltip: "初級者可⭐"
      tooltip.near: top-right
      cost-cut: {
        class: cost-cut
        description: ||md
          ## AI導入による変化
          | | AsIs | ToBe | 割合 |
          |-|-|-|-|
          | 情報アーキテクチャ | 手作業 | AI(一部手作業) | 20% |
          | UX(コンポーネント、ナビゲーション) | 手作業 | AI(一部手作業) | 40% |
          | 状態管理・セッション管理 | 手作業 | AI(一部手作業) | 20% |
          | スタイルガイド | 手作業 | AI(一部手作業) | 20% |
          ## 定量的に削減できる工数
          | AI効果種類 | 割合 | 工数への影響 |
          |-|-|-|
          | AI(一部手作業) | 100% | 50%減 |
          | **割合×工数への影響の合計** | 100% | **50%減** |
        ||
      }
    }

    develop-env {
      label: "環境構築"
      class: ai-effective-weak
      tooltip: "ベテラン向け⭐⭐⭐"
      tooltip.near: top-right
      cost-cut: {
        class:cost-cut
        description: ||md
          ## 作業内容
          - 動作環境・フレームワーク設計
          - 開発環境と運用官僚の両面から各種環境を決定する
          ## AI導入による変化
          | | AsIs | ToBe | 割合 |
          |-|-|-|-|
          | 環境設計 | 手作業 | AI(要レビュー) | 50% |
          | 開発環境導入 | 手作業 | AI(一部手作業) | 50% |
          ## 定量的に削減できる工数
          | AI効果種類 | 割合 | 工数への影響 |
          |-|-|-|
          | AI(要レビュー) | 50% | 90%減 |
          | AI(一部手作業) | 50% | 50%減 |
          | **割合×工数への影響の合計** | - | **70%減** |
        ||
      }
    }

    model: {
      label: "データモデル"
      class: ai-effective-weak
      tooltip: "ベテラン向け⭐⭐⭐"
      tooltip.near: top-right
      cost-cut: {
        class:cost-cut
        description: ||md
          ## 作業項目
          - エンジニアが決めるべきところ、実施すべきこと
            - 要求に対して必ず守るべきこと
            - 各種規則(命名規約など)
            - データ構造に関して人間が決めるべき部分
            - 外部サービスやAPIのキーの取得と環境変数への記述
          - AIの仕事
            - AIエージェントと技術者向けの文書を .md で残す
              - 物理削除、論理削除、履歴管理などについて明記する
              - 認証認可に関して記述する
          ## AI導入による変化
          | | 現在 | 導入後 | 割合 |
          |-|-|-|-|
          | 閲覧者 | エンジニア | AIとエンジニア | - |
          | メンテナンス | 放置されがち | 根幹の指示書であるため常に最新維持 | - |
          | 更新時 | 手作業 | 手作業またはAIのアシストを受けて更新、実装の更新をAIに指示する | - |
          | 設計作業 | 手作業 | AI(対話) | 100% |
          ## 定量的に削減できる工数
          | AI効果種類 | 割合 | 工数への影響 |
          |-|-|-|
          | AI(対話) | 100% | 80%減 |
          | **割合×工数への影響の合計** | - | **80%減** |
        ||
      }
    }

    backend {
      label: "バックエンド"

      endpoint {
        label: "サービス"
        class: ai-effective-weak
        tooltip: "初級者可⭐"
        tooltip.near: top-right

        cost-cut: {
          class: cost-cut
          description: ||md
            ## 作業項目
            - DTOとCRUD系APIはAIがデータモデルに即して直接実装するため設計不要となる
              - 実装時のレビューコストは残るが、設計はデータモデルの記述が終わった時点で完了している
            - API側の複雑なビジネスロジック、サービスは従来通りのデザインをAI支援下で行う
            - API側の決め事であるロギング、ヘルスチェックは従来通りのデザインをAI支援下で行う
            - API呼び出し側のエラー処理、リトライ処理、モニタリング処理は従来通りのデザインをAI支援下で行う
            ## AI導入による変化
            | | AsIs | ToBe | 割合 |
            |-|-|-|-|
            | **DTO設計 / CRUD設計** | 手作業 | 省略 | 25% |
            | ビジネスロジック設計 | 手作業 | AI(対話) | 35% |
            | サービス設計 | 手作業 | AI(対話) | 30% |
            | ロギング仕様、ヘルスチェック仕様 | 手作業 | AI(要レビュー) | 5% |
            | 呼び出し側のエラー処理、リトライ処理、モニタリング処理 | 手作業 | AI(要レビュー) | 5% |
            | リファレンス出力 | Swagger | Swagger | - |
            ## 定量的に削減できる工数
            | AI効果種類 | 割合 | 工数への影響 |
            |-|-|-|
            | 省略 | 25% | 100%減 |
            | AI(要レビュー) | 10% | 90%減 |
            | AI(対話) | 65% | 80%減 |
            | **割合×工数への影響の合計** | - | **86%減** |
          ||
        }
      }
      db {
        label: "データベース"
        class: ai-effective

        tooltip: "ベテラン向け⭐⭐⭐"
        tooltip.near: top-right
        cost-cut: {
          class: cost-cut
          description: ||md
            ## AI導入による変化
            | | AsIs | ToBe | 割合 |
            |-|-|-|-|
            | テーブル | 手作業 | AI(要レビュー) | 40% |
            | リレーション | 手作業 | AI(要レビュー) | 40% |
            | インデックス | 手作業 | AI(要レビュー) | 10% |
            | カスケード | 手作業 | AI(要レビュー) | 10% |

            ## 定量的に削減できる工数
            | 種類 | 割合 | 工数への影響 |
            |-|-|-|
            | AI(要レビュー) | 100% | 90% |
            | **割合×工数への影響の合計** | - | **90%減** |
          ||
        }
      }
      infra {
        label: "インフラ"
        class: ai-effective-weak
        tooltip: "ベテラン向け⭐⭐⭐"
        tooltip.near: top-right

        cost-cut: {
          class: cost-cut
          description: ||md
            ## 作業項目
            - インフラ設計
              - IaC実装のために必要な情報をまとめる設計
              - 作図言語などで人間もAIも読むことができるインフラ構成図を作成する
              - StepFunctionなどは小規模のものはフローチャート化する

            ## AI導入による変化
            | | AsIs | ToBe | 割合 |
            |-|-|-|-|
            | インフラ構成設計 | 手作業 | AI(対話) | 100% |

            ## 定量的に削減できる工数
            | 種類 | 割合 | 工数への影響 |
            |-|-|-|
            | AI(対話) | 100% | 80% |
            | **割合×工数への影響の合計** | - | **80%減** |
          ||
        }
      }
    }

    model -> backend.endpoint
  }
  implementation: {
    direction: right
    label: "実装・単体テスト"

    cost-cut: {
      class: cost-cut
      label: 実装全体のコストへの影響
      description: ||md
        # 定量的に削減できる工数
        | 項目 | 割合 | 工数への影響 |
        |-|-|-|
        | フロントエンド - 画面 | 45% | 80% |
        | フロントエンド - APIクライアント | 5% | 90% |
        | バックエンド(サービス) - 認証/認可 | 5% | 70% |
        | バックエンド(サービス) - APIエンドポイント | 5% | 90% |
        | バックエンド(サービス) - サービス | 30% | 62% |
        | バックエンド(インフラ) - データベース | 5% | 82% |
        | バックエンド(インフラ) - IaC | 4% | 90% |
        | CI/CD - 構築 | 1% | 90% |
        | **割合×工数への影響の合計** | 100% | **75.0%減** |
        ### 注意点
        - 各実装項目はテスト(動作確認)までの工程を含む
      ||
    }

    frontend {
      label: "フロントエンド"
      view {
        label: "画面"
        class: ai-effective-weak
        tooltip: "初級者可⭐"
        tooltip.near: top-right
        cost-cut: {
          class: cost-cut
          description: ||md
            ## 実装対象
            - UIコンポーネント
            - 状態管理
            - ルーティング
            - UIテスト
            ## AI導入による変化
            | | AsIs | ToBe | 割合 |
            |-|-|-|-|
            | UIコンポーネント | 手作業 | AI(要レビュー) | 50% |
