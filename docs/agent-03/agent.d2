classes: {
  command: {
    style: {
      fill: "#ffff88"
    }
  }
  ai-effective-weak: {
    style: {
      fill: "#ffcccc"
    }
  }
  ai-effective: {
    style: {
      fill: "#ff8888"
    }
  }
  ai-effective-strong: {
    style: {
      fill: "#cc4444"
      stroke: "#990000"
      stroke-width: 2
    }
  }
  cost-cut: {
    label: "コストへの影響"
    style: {
      stroke: "#990000"
      stroke-width: 4
    }
  }
  person: {
    shape: person
    style: {
      stroke: "blue"
      fill: "#aaffff"
    }
  }
  ai: {
    shape: person
    style: {
      stroke: "#6a1b9a"
      fill: "#f3e5f5"
    }
  }
  ai-field: {
    label: ""
    style: {
      stroke-width: 0
      fill: "#ffffff"
    }
  }
  field: {
    label: ""
    style: {
      stroke-width: 0
      fill: "#ffffff"
    }
  }

  spec: {
    style: {
      fill: "#fef3c7"
      stroke: "#d97706"
      stroke-width: 2
    }
  }
  agent: {
    style: {
      fill: "#e0e7ff"
      stroke: "#4f46e5"
      stroke-width: 2
    }
  }
  output: {
    style: {
      fill: "#f0fdf4"
      stroke: "#16a34a"
      stroke-width: 2
    }
  }
  human: {
    style: {
      fill: "#f1f5f9"
      stroke: "#475569"
    }
  }
}

grid-rows: 3

description: ||md
  # spec駆動開発(設計～実装・単体テスト)の効果分析
||

agents: spec駆動開発 {
  direction: right
  cost-cut: {
    class: cost-cut
    description: ||md
      # spec駆動開発の効果の計算(凡例)
      - 効果のレベルを5種類に区別する
        - **省略** : AIエージェントの導入により、省略される工程( **工数削減: 100%** )
        - **AI(要レビュー)** : AIエージェントの導入により、成果物に対するレビューのみ必要となるもの( **工数削減: 90%**)
        - **AI(対話)** : AIエージェントの導入により、エンジニアの手作業をほぼ肩代わりできるもの( **工数削減: 80%** )
        - **AI(一部手作業)** : AIエージェントの導入により、手作業はなくならないが工数を削減できるもの( **工数削減: 50%** )
        - (記載せず) : AIエージェント・AIアシスタントを導入してもエンジニアの工数が削減できないもの( **工数削減: 0%** )
      - 作業難易度
        - 自動化👑
        - ベテラン向け⭐⭐⭐
        - 初級者可⭐
      ||
  }

  # 人間系
  UserZone: 人間系 {
    style: {
      stroke-dash: 5
    }
    U: プロダクトオーナー\nエンジニアなど {
      shape: person
      class: human
    }
  }

  # 核となる仕様
  spec: "核: 実行可能な仕様書\n(Spec as Single Source of Truth)" {
    shape: cylinder
    class: spec
  }

  # AIエージェント群
  ai-orchestrator: AIエージェント群 {
    style: {
      fill: "#f8fafc"
    }

    # 計画フェーズ
    planning: プランニング {
      style: {
        stroke-dash: 5
      }
      architect: アーキテクトAI { class: agent }
      planner: プランナーAI { class: agent }

      # 計画フェーズ: 分析 → タスク化
      architect -> planner: analysis.md
    }

    # 設計・実装フェーズ
    build: 設計・実装 {
      style: {
        stroke-dash: 5
      }

      # 実行指揮
      orchestrator: オーケストレーターAI { class: agent }

      # 実装エージェント
      coder: 実装エージェント群 {
        db-architect: DBアーキテクトAI { class: agent }
        backend: バックエンドAI { class: agent }
        frontend: フロントエンドAI { class: agent }
      }

      # レビュー・テスト
      reviewer: バックエンドレビュワーAI { class: agent }
      tester: テスターAI { class: agent }

      # オーケストレーターによる連鎖呼び出し
      orchestrator -> coder: 順次起動
      orchestrator -> reviewer: レビュー依頼
      orchestrator -> tester: テスト依頼

      # 実装エージェント間のデータ受け渡し
      coder.db-architect -> coder.backend: schema.prisma
      coder.backend -> coder.frontend: API / DTO

      # レビュー・テストループ
      coder.backend -> reviewer: 実装コード
      reviewer -> coder.backend: 指摘・差戻し
      coder -> tester: 実装一式
      tester -> orchestrator: 結果 / 不具合レポート
    }

    # 実行フェーズへの引き渡し
    planning.planner -> build.orchestrator: 親タスク (Backlog)
    planning.architect -> build.orchestrator: analysis.md
  }

  # アウトプット (CI/CD)
  cd-ci: アウトプット {
    Prod: プロダクトコード { class: output }
    Doc: 技術ドキュメント\nテスト結果 { class: output }
  }

  # インタラクション（接続関係）
  UserZone.U -> spec: 仕様定義/プロンプト
  spec <-> ai-orchestrator.planning.planner: コンテキスト参照/更新
  spec <-> ai-orchestrator.planning.architect: コンテキスト参照/更新

  ai-orchestrator.build.coder -> cd-ci.Prod: 最終コード
  ai-orchestrator.build.tester -> cd-ci.Doc: レポート

  cd-ci.Prod -> UserZone: デプロイ {
    style: { stroke-dash: 3 }
  }
  cd-ci.Doc -> UserZone: レビュー {
    style: { stroke-dash: 3 }
  }
}

dev: {
  class: field
  grid-columns: 6
  grid-gap: 0

  requirement: {
    direction: right
    label: "要求"
    development {
      label: "要求開発"
    }
    management {
      label: "要求管理"
    }
  }
  specification: {
    label: "要件・仕様定義"
    detail: {
      label: ""
      grid-rows: 2
      grid-gap: 0
      style: {
        fill: white
        stroke-width: 0
      }
      ipo: {
        label: ""
        style: {
          fill: transparent
          stroke-width: 0
        }

        # 入力: 資料群
        input: 入力資料 {
          initial-docs: {
            label: "初期資料 (60%)\n(データ構造資料 / ラフスケッチ / 機能一覧)\nAI(一部手作業) → 50%減"
            class: ai-effective-weak
          }
          change-docs: {
            label: "変更管理文書 (25%)\nAI(一部手作業) → 50%減"
            class: ai-effective-weak
          }
          defects: {
            label: "不具合対応 (15%)\n(運用フィードバック / 障害レポート)\nAI(一部手作業) → 50%減"
            class: ai-effective-weak
          }
        }

        # AIによる分析・タスク化
        planning: 要件・仕様の分析とタスク化を行うAIエージェント群 {
          architect: アーキテクトAI {
            label: "アーキテクトAI\nドメインモデルを書き起こす\n責務分析 / 影響範囲 / 整合チェック / 技術選定"
            class: agent
          }
          planner: プランナーAI {
            label: "プランナーAI\nドメインモデルを基に\n親タスクを分解し Backlog 起票"
            class: agent
          }
          architect -> planner: ドメインモデル / analysis.md
          node: {
            label: "タスク化のポイント"
            description: ||md
              - タスクはAIエージェントが実装可能なレベルまで分解する
              - タスクの粒度は、AIエージェントが1回の呼び出しで完了できる程度にする
              - タスク間の依存関係や優先順位も明確にする
            ||
          }
        }

        # 出力 (マネージャ向け)
        output: アウトプット {
          domain-model: {
            label: "ドメインモデル\n(機能・データ構造の全体像)"
          }
          backlog: {
            label: "Backlog 親タスク (WBS)\n機能一覧 + 依存・優先順位"
          }
          estimate: {
            label: "見積り\n(期間 / コスト / AI運用費)"
          }
          assignment: {
            label: "体制 (担当配分)\nAI ↔ エンジニア\nベテラン ↔ 初級者"
          }
          risk: {
            label: "前提・リスク\n(変更/不具合への対応方針)"
          }
        }

        manual: {
          label: "どの範囲まではspec駆動開発にするかの判断"
          description: ||md
            ## 判定方法
            - **プランナーAIが出力したタスクをエンジニアがレビューし、適切な分析が行われていない場合**

            ### AI駆動が適切に機能しないケースの原因
            - **アーキテクトAI** が適切に分析できない場合
                - 仕様の複雑さや不明瞭さが原因で、ドメインモデルが不完全・不正確になっている
            - **プランナーAI** が正しくスコープを切れない場合
                - アーキテクトAIの分析が不明瞭であることが原因で、タスクの切り出しが不適切になっている
            - 変更管理や不具合対応の内容が既存のタスクと部分的に重なっている場合、または乖離している（大きな仕様変更である）場合

            ## 対応方法
            - エンジニアが AI に範囲調整や追加情報や制約を渡して再分析させる
                - AIに「不明点リスト」を出させ、顧客や PO に質問してから再開
                - 全てspec駆動でやるのではなく、範囲を絞らせる
            - spec駆動の適用を一時的・または部分的に見送り、従来の方法で要件・仕様定義を行う
                - この場合もAI支援を受けて効率化を図る
          ||
        }

        sdd {
          label: "spec駆動開発"
          description: ||md
            - オーケストレーションAI以降の実装系AIエージェントによってタスクの実装を自動化する
          ||
        }
        ai-assist {
          label: "AI支援開発"
          description: ||md
            - 個々のAIエージェントに可能なところをAIに任せる(オーケストレーションは手動)
            - AIが得意なところはAIに任せるが、AIが苦手なところは人間が担うハイブリッドな開発スタイル
          ||
        }
        manual -> sdd: "spec駆動する範囲"
        manual -> ai-assist: "AI支援する範囲"

        cost-cut: {
          class: cost-cut
          label: 「要件定義を基にした分析・タスク化」の工数削減効果
          description: ||md
            # 定量的に削減できる工数
            - 要件・仕様定義自体はここに含まない

            ## 入力の物量的な割合
            - **初期資料**: 60% (新規開発の主体、初期に集中)
            - **変更管理**: 25% (継続的に発生)
            - **不具合対応**: 15% (運用段階で発生)

            ## AI 駆動 / AI 支援による工数影響
            | 項目 | 割合 | AI効果種類 | 工数への影響 |
            |-|-|-|-|
            | 初期資料の分析・ドメインモデル化・タスク化 | 60% | AI(一部手作業) | 50%減 |
            | 変更管理対応 (既存実装との整合確認が必要、AI支援寄り) | 25% | AI(一部手作業) | 50%減 |
            | 不具合対応 (影響範囲特定が複雑、AI支援寄り) | 15% | AI(一部手作業) | 50%減 |
            | **割合×工数への影響の合計** | 100% | - | **約 50%減** |

            ### 注記
            - 上記比率は一般的なプロジェクトを想定した概算
            - プロジェクト特性 (新規開発比率 / 運用フェーズ比率) で大きく変動する
          ||
        }

        # 接続関係
        input.initial-docs -> planning.architect
        input.change-docs -> planning.architect: 変更発生時
        input.defects -> planning.architect: 不具合発生時

        planning.architect -> output.domain-model
        planning.planner -> output.backlog
        planning.planner -> output.estimate
        planning.planner -> output.assignment
        planning.architect -> output.risk

        output -> manual

        # スタイリング
        input: { style.fill: "#e1f5fe" }
        planning: { style.fill: "#fff3e0" }
        output: { style.fill: "#e8f5e9" }
      }
    }
  }
  design: {
    direction: right
    label: "設計"
    cost-cut: {
      class: cost-cut
      label: 設計全体のコストへの影響
      description: ||md
        # 定量的に削減できる工数
        | 項目 | 割合 | 工数への影響 |
        |-|-|-|
        | 環境構築 | 5% | 70% |
        | タスク | 5% | 100% |
        | フロントエンド | 40% | 50% |
        | データモデル | 10% | 80% |
        | バックエンド - サービス | 20% | 86% |
        | バックエンド - データベース | 10% | 90% |
        | バックエンド - インフラ | 10% | 80% |
        | **割合×工数への影響の合計** | 100% | **70.7%減** |
      ||
    }

    task: {
      label: "設計・実装タスク管理"
      task-detailed: {
        label: "タスク"
        class: ai-effective
        tooltip: "自動化👑"
        tooltip.near: top-right
        cost-cut: {
          class: cost-cut
          description: ||md
            ## 対象となる作業
            - エピック、ストーリー、フィーチャーを個別のタスクにする
              - 従来 : 担当エンジニアへの割り当て
                - タスクをチケット化する
              - 変化 : AIエージェントに向けたタスクとして切り出す
                - リポジトリ上に一時的に出力して、タスクを終えたら削除する
                - 永続的な文書はチケットに残す
            ## 定量的に削減できる工数
            | AI効果種類 | 工数割合 | 削減効果 |
            |-|-|-|
            | 省略 | 100% | 100% |
            | **割合×工数への影響の合計** | 100% | **100%減** |
          ||
        }
      }
    } 
    task -> frontend
    task -> backend
    task -> develop-env

    frontend {
      label: "フロントエンド"
      class: ai-effective-weak
      tooltip: "初級者可⭐"
      tooltip.near: top-right
      cost-cut: {
        class: cost-cut
        description: ||md
          ## AI導入による変化
          | | AsIs | ToBe | 割合 |
          |-|-|-|-|
          | 情報アーキテクチャ | 手作業 | AI(一部手作業) | 20% |
          | UX(コンポーネント、ナビゲーション) | 手作業 | AI(一部手作業) | 40% |
          | 状態管理・セッション管理 | 手作業 | AI(一部手作業) | 20% |
          | スタイルガイド | 手作業 | AI(一部手作業) | 20% |
          ## 定量的に削減できる工数
          | AI効果種類 | 割合 | 工数への影響 |
          |-|-|-|
          | AI(一部手作業) | 100% | 50%減 |
          | **割合×工数への影響の合計** | 100% | **50%減** |
        ||
      }
    }

    develop-env {
      label: "環境構築"
      class: ai-effective-weak
      tooltip: "ベテラン向け⭐⭐⭐"
      tooltip.near: top-right
      cost-cut: {
        class:cost-cut
        description: ||md
          ## 作業内容
          - 動作環境・フレームワーク設計
          - 開発環境と運用官僚の両面から各種環境を決定する
          ## AI導入による変化
          | | AsIs | ToBe | 割合 |
          |-|-|-|-|
          | 環境設計 | 手作業 | AI(要レビュー) | 50% |
          | 開発環境導入 | 手作業 | AI(一部手作業) | 50% |
          ## 定量的に削減できる工数
          | AI効果種類 | 割合 | 工数への影響 |
          |-|-|-|
          | AI(要レビュー) | 50% | 90%減 |
          | AI(一部手作業) | 50% | 50%減 |
          | **割合×工数への影響の合計** | - | **70%減** |
        ||
      }
    }

    model: {
      label: "データモデル"
      class: ai-effective-weak
      tooltip: "ベテラン向け⭐⭐⭐"
      tooltip.near: top-right
      cost-cut: {
        class:cost-cut
        description: ||md
          ## 作業項目
          - エンジニアが決めるべきところ、実施すべきこと
            - 要求に対して必ず守るべきこと
            - 各種規則(命名規約など)
            - データ構造に関して人間が決めるべき部分
            - 外部サービスやAPIのキーの取得と環境変数への記述
          - AIの仕事
            - AIエージェントと技術者向けの文書を .md で残す
              - 物理削除、論理削除、履歴管理などについて明記する
              - 認証認可に関して記述する
          ## AI導入による変化
          | | 現在 | 導入後 | 割合 |
          |-|-|-|-|
          | 閲覧者 | エンジニア | AIとエンジニア | - |
          | メンテナンス | 放置されがち | 根幹の指示書であるため常に最新維持 | - |
          | 更新時 | 手作業 | 手作業またはAIのアシストを受けて更新、実装の更新をAIに指示する | - |
          | 設計作業 | 手作業 | AI(対話) | 100% |
          ## 定量的に削減できる工数
          | AI効果種類 | 割合 | 工数への影響 |
          |-|-|-|
          | AI(対話) | 100% | 80%減 |
          | **割合×工数への影響の合計** | - | **80%減** |
        ||
      }
    }

    backend {
      label: "バックエンド"

      endpoint {
        label: "サービス"
        class: ai-effective-weak
        tooltip: "初級者可⭐"
        tooltip.near: top-right

        cost-cut: {
          class: cost-cut
          description: ||md
            ## 作業項目
            - DTOとCRUD系APIはAIがデータモデルに即して直接実装するため設計不要となる
              - 実装時のレビューコストは残るが、設計はデータモデルの記述が終わった時点で完了している
            - API側の複雑なビジネスロジック、サービスは従来通りのデザインをAI支援下で行う
            - API側の決め事であるロギング、ヘルスチェックは従来通りのデザインをAI支援下で行う
            - API呼び出し側のエラー処理、リトライ処理、モニタリング処理は従来通りのデザインをAI支援下で行う
            ## AI導入による変化
            | | AsIs | ToBe | 割合 |
            |-|-|-|-|
            | **DTO設計 / CRUD設計** | 手作業 | 省略 | 25% |
            | ビジネスロジック設計 | 手作業 | AI(対話) | 35% |
            | サービス設計 | 手作業 | AI(対話) | 30% |
            | ロギング仕様、ヘルスチェック仕様 | 手作業 | AI(要レビュー) | 5% |
            | 呼び出し側のエラー処理、リトライ処理、モニタリング処理 | 手作業 | AI(要レビュー) | 5% |
            | リファレンス出力 | Swagger | Swagger | - |
            ## 定量的に削減できる工数
            | AI効果種類 | 割合 | 工数への影響 |
            |-|-|-|
            | 省略 | 25% | 100%減 |
            | AI(要レビュー) | 10% | 90%減 |
            | AI(対話) | 65% | 80%減 |
            | **割合×工数への影響の合計** | - | **86%減** |
          ||
        }
      }
      db {
        label: "データベース"
        class: ai-effective

        tooltip: "ベテラン向け⭐⭐⭐"
        tooltip.near: top-right
        cost-cut: {
          class: cost-cut
          description: ||md
            ## AI導入による変化
            | | AsIs | ToBe | 割合 |
            |-|-|-|-|
            | テーブル | 手作業 | AI(要レビュー) | 40% |
            | リレーション | 手作業 | AI(要レビュー) | 40% |
            | インデックス | 手作業 | AI(要レビュー) | 10% |
            | カスケード | 手作業 | AI(要レビュー) | 10% |

            ## 定量的に削減できる工数
            | 種類 | 割合 | 工数への影響 |
            |-|-|-|
            | AI(要レビュー) | 100% | 90% |
            | **割合×工数への影響の合計** | - | **90%減** |
          ||
        }
      }
      infra {
        label: "インフラ"
        class: ai-effective-weak
        tooltip: "ベテラン向け⭐⭐⭐"
        tooltip.near: top-right

        cost-cut: {
          class: cost-cut
          description: ||md
            ## 作業項目
            - インフラ設計
              - IaC実装のために必要な情報をまとめる設計
              - 作図言語などで人間もAIも読むことができるインフラ構成図を作成する
              - StepFunctionなどは小規模のものはフローチャート化する

            ## AI導入による変化
            | | AsIs | ToBe | 割合 |
            |-|-|-|-|
            | インフラ構成設計 | 手作業 | AI(対話) | 100% |

            ## 定量的に削減できる工数
            | 種類 | 割合 | 工数への影響 |
            |-|-|-|
            | AI(対話) | 100% | 80% |
            | **割合×工数への影響の合計** | - | **80%減** |
          ||
        }
      }
    }

    model -> backend.endpoint
  }
  implementation: {
    direction: right
    label: "実装・単体テスト"

    cost-cut: {
      class: cost-cut
      label: 実装全体のコストへの影響
      description: ||md
        # 定量的に削減できる工数
        | 項目 | 割合 | 工数への影響 |
        |-|-|-|
        | フロントエンド - 画面 | 45% | 80% |
        | フロントエンド - APIクライアント | 5% | 90% |
        | バックエンド(サービス) - 認証/認可 | 5% | 70% |
        | バックエンド(サービス) - APIエンドポイント | 5% | 90% |
        | バックエンド(サービス) - サービス | 30% | 62% |
        | バックエンド(インフラ) - データベース | 5% | 82% |
        | バックエンド(インフラ) - IaC | 4% | 90% |
        | CI/CD - 構築 | 1% | 90% |
        | **割合×工数への影響の合計** | 100% | **75.0%減** |
        ### 注意点
        - 各実装項目はテスト(動作確認)までの工程を含む
      ||
    }

    frontend {
      label: "フロントエンド"
      view {
        label: "画面"
        class: ai-effective-weak
        tooltip: "初級者可⭐"
        tooltip.near: top-right
        cost-cut: {
          class: cost-cut
          description: ||md
            ## 実装対象
            - UIコンポーネント
            - 状態管理
            - ルーティング
            - UIテスト
            ## AI導入による変化
            | | AsIs | ToBe | 割合 |
            |-|-|-|-|
            | UIコンポーネント | 手作業 | AI(要レビュー) | 50% |
            | ルーティング | 手作業 | AI(一部手作業) | 20% | 
            | 状態管理 | 手作業 | AI(対話) | 20% |
            | UIテスト | 手作業 | AI(要レビュー) | 10% |

            ## 定量的に削減できる工数
            | AI効果種類 | 割合 | 工数への影響 |
            |-|-|-|
            | AI(要レビュー) | 60% | 90%減 |
            | AI(対話) | 20% | 80%減 |
            | AI(一部手作業) | 20% | 50%減 |
            | **割合×工数への影響の合計** | - | **80%減** |
          ||
        }
      }

      api-client {
        label: "APIクライアント"
        class: ai-effective
        tooltip: "初級者可⭐"
        tooltip.near: top-right
        cost-cut: {
          class: cost-cut
          description: ||md
            ## AI導入による変化
            | | AsIs | ToBe | 割合 |
            |-|-|-|-|
            | クライアント(REST/GraphQL/WebSocket) | 手作業 | AI(要レビュー) | 50% |
            | エラー処理 | 手作業 | AI(要レビュー) | 30% |
            | リトライ処理 | 手作業 | AI(要レビュー) | 10% | 
            | モニタリング処理 | 手作業 | AI(要レビュー) | 10% |
            ## 定量的に削減できる工数
            | 種類 | 割合 | 工数への影響 |
            |-|-|-|
            | AI(要レビュー) | 100% | 90% |
            | **割合×工数への影響の合計** | - | **90%減** |
          ||
        }
      }
    }

    backend {
      label: "バックエンド"

      services {
        label: "サービス層"
        
        auth {
          label: "認証/認可"
          class: ai-effective-weak
          tooltip: "ベテラン向け⭐⭐⭐"
          tooltip.near: top-right
          cost-cut: {
            class: cost-cut
            description: ||md
              ## AI導入による変化
              | | AsIs | ToBe | 割合 |
              |-|-|-|-|
              | ユーザ管理 | 手作業 | AI(要レビュー) | 25% |
              | 権限管理 | 手作業 | AI(要レビュー) | 25% |
              | セッション管理 | 手作業 | AI(一部手作業) | 25% |
              | OAuth実装 | 手作業 | AI(一部手作業) | 25% |
              ## 定量的に削減できる範囲
              | AI効果種類 | 割合 | 工数への影響 |
              |-|-|-|
              | AI(要レビュー) | 50% | 90%減 |
              | AI(一部手作業) | 50% | 50%減 |
              | **割合×工数への影響の合計** | - | **70%減** |
            ||
          }
        }
        api {
          label: "APIエンドポイント"
          class: ai-effective
          tooltip: "初級者可⭐"
          tooltip.near: top-right
          cost-cut: {
            class: cost-cut
            description: ||md
              ## 実装項目
              - DTO実装
              - エンドポイント(REST/GraphQL/WebSocket)
              - 入力バリデーション(Request/Response)
              - ロギング
              - ヘルスチェック
              ## AI導入による変化
              | | AsIs | ToBe | 割合 |
              |-|-|-|-|
              | 実装作業 | 手作業 | AI(要レビュー) | 100% |
              ## 定量的に削減できる範囲
              | AI効果種類 | 割合 | 工数への影響 |
              |-|-|-|
              | AI(要レビュー) | 100% | 90%減 |
              | **割合×工数への影響の合計** | - | **90%減** |
            ||
          }
        }
        service-definition {
          label: "サービス"
          class: ai-effective-weak
          tooltip: "初級者可⭐"
          tooltip.near: top-right
          cost-cut: {
            class: cost-cut
            description: ||md
              ## AI導入による変化
              | | AsIs | ToBe | 割合 |
              |-|-|-|-|
              | ドメインモデル(ビジネスルール、計算ロジック) | 手作業 | AI(一部手作業) | 60% |
              | 基盤クラス作成 | 手作業 | AI(一部手作業) | 10% |
              | CRUD処理 | 手作業 | AI(要レビュー) | 20% |
              | ユニットテスト | 手作業 | AI(要レビュー) | 10% |
              ## 定量的に削減できる範囲
              | AI効果種類 | 割合 | 工数への影響 |
              |-|-|-|
              | AI(要レビュー) | 30% | 90%減 |
              | AI(一部手作業) | 70% | 50%減 |
              | **割合×工数への影響の合計** | - | **62%減** |
            ||
          }
        }
      }
      infrastructure {
        label: "インフラ層"

        # 永続化グループ（DBアクセス関連）
        db: {
          class: ai-effective
          label: "データベース"
          tooltip: "ベテラン向け⭐⭐⭐"
          tooltip.near: top-right

          cost-cut: {
            class: cost-cut
            description: ||md
              ## AI導入による変化
              | | AsIs | ToBe | 割合 |
              |-|-|-|-|
              | ORMモデル定義(スキーマ記述、インデックス管理、カスケード削除設定) | 手作業 | AI(要レビュー) | 80% |
              | - DBマイグレーション | ORMからコマンド生成 | ORMからコマンド生成 | - |
              | - SQLクエリ | ORMからコマンド生成 | ORMからコマンド生成 | - |
              | トランザクション管理 | 手作業 | AI(一部手作業) | 20% |
              ## 定量的に削減できる範囲
              | AI効果種類 | 割合 | 工数への影響 |
              |-|-|-|
              | AI(要レビュー) | 80% | 90%減 |
              | AI(一部手作業) | 20% | 50%減 |
              | **割合×工数への影響の合計** | - | **82%減** |
            ||
          }
        }
        iac: {
          label: "IaC(Infrastructure as Code)"
          class: ai-effective
          tooltip: "ベテラン向け⭐⭐⭐"
          tooltip.near: top-right
          cost-cut: {
            class: cost-cut
            description: ||md
              ## 実装項目
              - 本番環境デプロイ
              - クラウドプロバイダ
              - コンテナオーケストレーション
              - サーバー管理
              - スケーリング
              - DB管理
              - バックアップ/リストア
              - ファイルストレージ
              ## AI導入による変化
              | | AsIs | ToBe | 割合 |
              |-|-|-|-|
              | 実装項目 | 手作業 | AI(要レビュー) | 100% |
              ## 定量的に削減できる範囲
              | AI効果種類 | 割合 | 工数への影響 |
              |-|-|-|
              | AI(要レビュー) | 100% | 90%減 |
              | **割合×工数への影響の合計** | - | **90%減** |
            ||
          }
        }
      }

    }

    ci-cd: {
      label: "CI/CD"
      setup: {
        label: "構築"
        class: ai-effective
        tooltip: "ベテラン向け⭐⭐⭐"
        tooltip.near: top-right
        cost-cut: {
          class: cost-cut
          description: ||md
          ## 定量的に削減できる範囲
          | AI効果種類 | 割合 | 工数への影響 |
          |-|-|-|
          | 構築 | 100% | 90%減 |
          | **割合×工数への影響の合計** | - | **90%減** |
          ||
        }
      }
    }
    frontend -> ci-cd;
    backend -> ci-cd
  }
  design.frontend -> implementation.frontend.view
  design.backend -> implementation.frontend.api-client
  design.backend -> implementation.backend

  integration-test: {
    label: "結合テスト"
    direction: right
    user-flow-e2e: {
      label: "ユーザーフローのE2Eテスト"
      class: ai-effective
    }
    contract: {
      label: "契約テスト(サービス間API通信)"
      class: ai-effective
    }
    cross-browser: {
      label: "クロスブラウザテスト"
      class: ai-effective-weak
    }
    black-box: {
      label: "ブラックボックステスト\nモンキーテストなど"
      class: ai-effective-weak
    }
    scenario: {
      label: "シナリオテスト"
      class: ai-effective-weak
    } 
    staging: {
      label: "ステージング環境テスト"
      class: ai-effective-weak
    }

    security-review {
      label: "セキュリティレビュー"
      class: ai-effective-weak
    }
  }
  ops {
    direction: right
    label: "運用/保守"
    
    monitoring {
      label: "監視"
    }
    
    logging {
      label: "ログ管理"
    }
    
