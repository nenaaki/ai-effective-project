classes {
  blank: {
    label: ""
    style: {
      fill: white
      stroke-width: 0
    }
  }
  dash: {
    label: ""
    style: {
      fill: white
      stroke-dash: 2
      stroke-width: 2
    }
  }
  task: {
    icon: "./images/list-check-solid-full.svg"
    icon.near: top-right
    style: {
      fill: white
    }
    grid-rows: 2
    grid-gap: 8
  }
  sdd: {
    icon: "./images/claudecode-color.svg"
    icon.near: top-left
    style: {
      fill: "#ddffdd"
    }
  }
  assist: {
    icon: "./images/claudecode-color.svg"
    icon.near: top-left
    style: {
      fill: "#fff4dd"
      stroke-dash: 3
    }
  }
  agent: {
    icon: "./images/claudecode-color.svg"
    icon.near: top-left
    style: {
      fill: "#e6f0ff"
    }
  }
}

grid-columns: 2

grid {
  grid-rows: 3
  class: blank

  pm: {
    label: ""
    description: ||md
      ## プロジェクト管理者
      - プロジェクト管理の方法は変化しません。
      - 従来通りBacklog等のタスクのWBSの状況がそのままの進捗状況となります。
    ||
  }

  legend: {
    label: "凡例"
    style {
      fill: white
    }
    task: {
      class: task
      label: ""
      description: ||md
        ## タスク
      ||
      sdd: {
        class: sdd
        label: "AI駆動で実装する範囲\n(spec駆動開発)"
      }
      assist: {
        class: assist
        label: "AI支援で実装する範囲\n(エンジニア主導)"
      }
    }
  }

  agents: {
    label: "AIエージェント群"
    grid-rows: 4
    grid-columns: 2
    grid-gap: 16

    planner: {
      label: "プランナーAI"
      class: agent
      description: ||md
        **役割**: タスク・チケット管理
        ### 入力
        - 親タスク(画面・機能)
        - アーキテクトAIの分析結果
        - 変更管理から出た仕様
        ### 出力
        - 粒度・順序を整えた **子タスク群**
        - チケット起票・関連付け
        - WBS上の進捗状態
      ||
    }

    architect: {
      label: "アーキテクトAI"
      class: agent
      description: ||md
        **役割**: 実装検討・責務分析
        ### 入力
        - 親タスク(画面・機能)
        - 要件・仕様(顧客文書/内部文書)
        - 既存実装の構造
        ### 出力
        - 画面・機能の **責務分析**
        - **実装範囲・影響範囲** の整理
        - ドメインモデル整合チェック結果
        - アーキテクチャ方針メモ
      ||
    }

    db-architect: {
      label: "DBアーキテクトAI"
      class: agent
      description: ||md
        ### 入力
        - テーブル仕様(データ名・フィールド・制約・リレーション)
        ### 出力
        - **schema.prisma**
        - DBマイグレーション
        - インデックス・カスケード設計
      ||
    }

    backend: {
      label: "バックエンドAI"
      class: agent
      description: ||md
        ### 入力
        - schema.prisma
        - 機能仕様(画面・機能から導かれるAPI要求)
        ### 出力
        - **DTO・バリデーション**(Zod等)
        - **GraphQLスキーマ**
        - API実装(リゾルバー・サービス層)
        - ユニットテストコード
      ||
    }

    backend-reviewer: {
      label: "バックエンドレビュワーAI"
      class: agent
      description: ||md
        ### 入力
        - バックエンドAIの実装コード
        - 仕様(DTO・API仕様)
        ### 出力
        - レビュー指摘・修正提案
        - セキュリティ・性能観点の警告
      ||
    }

    frontend: {
      label: "フロントエンドAI"
      class: agent
      description: ||md
        ### 入力
        - **API**(バックエンドAIの出力)
        - **画面仕様**(UX設計図)
        ### 出力
        - 画面実装(ページ・コンポーネント)
        - API連携・状態管理処理
      ||
    }

    tester: {
      label: "テスターAI"
      class: agent
      description: ||md
        ### 入力
        - 仕様(API・画面)
        - 実装コード
        ### 出力
        - テストコード(統合・E2E)
        - 実行結果・不具合レポート
      ||
    }
  }
}

develop {
  class: blank

  start: {
    label: "開発開始"
    shape: circle
  }

  start -> requirements

  requirements {
    label: "要件一覧・仕様一覧"
    agreement {
      class: dash
      label: "お客様と合意済みのもの"
      excel {
        class: blank
        label: "データ構造資料"
        icon: "https://res-1.cdn.office.net/files/fabric-cdn-prod_20251008.001/assets/brand-icons/product/svg/excel_48x1.svg"
      }
      power-point {
        class: blank
        label: "ラフスケッチ"
        icon: "https://res-1.cdn.office.net/files/fabric-cdn-prod_20251008.001/assets/brand-icons/product/svg/powerpoint_48x1.svg"
      }
      design {
        class: blank
        label: "機能一覧"
        icon: "https://res-1.cdn.office.net/files/fabric-cdn-prod_20251008.001/assets/brand-icons/product/svg/excel_48x1.svg"
      }
      management: {
        label: "変更管理"
        excel {
          class: blank
          label: ""
          icon: "https://res-1.cdn.office.net/files/fabric-cdn-prod_20251008.001/assets/brand-icons/product/svg/excel_48x1.svg"
        }
      }
    }
    requirement: {
      grid-columns: 3
      label: "内部文書"
      backlog: {
        label: "ticket"
        shape: image
        icon: "https://backlog.com/app/themes/backlog-child/assets/img/common/logo/logo_backlog.svg"
      }
      markdown: {
        label: "wiki, README等"
        shape: image
        icon: "./images/markdown-brands-solid-full.svg"
      }
      github: {
        label: "issue, source code"
        shape: image
        icon: "./images/github-brands-solid-full.svg"
      }
      environment: ||md
      ## エンジニアが事前考慮した情報群
      - 開発環境
        - フレームワーク
        - 言語
      - 運用環境
        - インフラ
        - セキュリティ
      ||
      api {
        class: blank
        label: "API・認証認可資料"
        icon: "https://res-1.cdn.office.net/files/fabric-cdn-prod_20251008.001/assets/brand-icons/product/svg/excel_48x1.svg"
      }
    }
  }

  ai-process {
    icon: "./images/claudecode-color.svg"
    label: "要件・仕様の分析 → 親タスク化"
    description: ||md
      **担当**: アーキテクトAI + プランナーAI

      ### 入力
      - お客様合意済み資料 (データ構造資料 / ラフスケッチ / 機能一覧 / モックアップ)
      - 内部文書 (Backlogチケット / wiki / GitHub / API・認証認可資料)
      - エンジニアが事前考慮した情報群 (開発環境 / 運用環境)

      ### 処理
      - **アーキテクトAI**
        - 要件・仕様の読解と整理
        - 画面・機能の洗い出しと責務分析
        - 既存実装・ドメインモデルとの整合チェック
        - 技術選定・実装方針の検討
        - 影響範囲・依存関係の整理
      - **プランナーAI**
        - 画面・機能を親タスク(エピック/フィーチャー)へ分解
        - 親タスクの粒度・優先順位・順序の調整
        - Backlog 上のチケット起票と関連付け

      ### 出力
      - 親タスク群 (画面・機能ごとに1つ)
      - アーキテクチャ方針メモ
      - 実装範囲・影響範囲の整理結果
      - 子タスク起票のための前提情報
    ||
  }
  requirements.agreement.excel -> ai-process: MarkItDownによる変換
  requirements.agreement.power-point -> ai-process: MarkItDownによる変換
  requirements.agreement.design -> ai-process: MarkItDownによる変換
  requirements.requirement -> ai-process: 必要に応じて\nMarkItDownによる変換

  ai-process -> parent-tasks.task
  parent-tasks {
    label: "親タスク群"
    icon: "https://backlog.com/app/themes/backlog-child/assets/img/common/logo/logo_backlog.svg"
    icon.near: top-left

    note: {
      class: blank
      description: ||md
        ## タスクの区切り方と消化の仕方
        - 1つの画面・機能 ≒ 1つの親タスクとします
        - 子タスクはAIに起票させ、エンジニアが内容を精査して修正を加えます
        - **「できる限り」モデルファーストでタスクを消化します**
        - AIはタスクに記載された情報を最も信頼性の高いソースとして処理します
        - 機能の規模によっては、タスクをまとめるor分割することはOK
        - AI自動生成が困難なものは、AIアシストによって実施するタスクを作る
      ||
    }

    setup: {
      label: ""
      class: task
      grid-rows: 2
      grid-gap: 8
      description: ||md
        ## 開発環境の立ち上げ
        案件に合わせた開発環境を構築します。
      ||
      setup-sdd {
        label: ""
        class: assist
        description: ||md
          ## spec駆動開発環境
          **担当**: エンジニア (Claude Code支援)
          - spec駆動開発ファイル群を組み込み
            - skills / agents / mcp の設定
          - CLAUDE.md をプロジェクトに合わせて記述
          - 6エージェント(プランナー〜テスター)の起動準備
        ||
      }
    }

    task: {
      label: "親タスク(画面・機能)\nエピック or フィーチャー"
      class: task
      style.multiple: true
    }

    change-task: {
      label: "変更対応タスク\n(改修・追加要件)"
      class: task
      style.multiple: true
      description: ||md
        ## 変更管理から発生するタスク
        - 変更管理から出てきた仕様は、現時点では **AI駆動ではなく AI支援** で実装します
        - 既存実装の文脈・影響範囲の把握が必要なため、エンジニア主導で進めます
        - AIはコード生成・調査・テスト作成などの局所支援に留まります
      ||
      assist: {
        label: ""
        class: assist
        description: ||md
          ## AI支援で実装
          ### 進め方
          - エンジニアが既存実装と仕様差分を読み解き、変更方針・スコープを決定
          - **アーキテクトAI** が影響範囲分析・整合性チェックを支援
          - スコープ確定後、専門AIにエンジニアが切り出した局所作業を依頼:
            - **DBアーキテクトAI**: スキーマ差分・マイグレーション生成
            - **バックエンドAI**: 該当エンドポイント・サービスの追加/修正
            - **フロントエンドAI**: 画面・コンポーネントの局所修正
            - **テスターAI**: 影響範囲のテスト追加・リグレッション確認
          - プランナーAI は出番が少ない (タスク全体分解の信頼性が落ちるため)
          ### spec駆動との違い
          - 仕様→実装をAIに任せきりにしない
          - 各専門AIは「エンジニアが切り出したスコープ内」で動作
          - 既存資産との整合性確認が主作業
        ||
      }
    }
  }

  requirements.agreement.management -> parent-tasks.change-task: "変更仕様"
  requirements.requirement -> parent-tasks.setup

  design: {
    class: dash
    label: "設計"
    ux: {
      label: ""
      class: task
      description: ||md
        ## UX設計
        ### 入力
        - 画面
        - 機能
        ### エンジニアによる処理
        - AIが作るべきものの仕様書を記述
        - 画面遷移
      ||
      sdd: {
        label: ""
        class: sdd
        description: ||md
          **担当**: アーキテクトAI + フロントエンドAI
          ### 処理
          - アーキテクトAI: 画面・機能の責務精査、ドメイン整合チェック
          - フロントエンドAI: プロトタイプ生成
          ### 出力
          - UX設計図
          - 画面が扱う情報のまとめ
        ||
      }
    }

    data-model-design: {
      class: task
      label: ""
      description: ||md
        ## データモデル設計
        > **エンジニアとAIが対話してデータ構造を決定する** タスクです。<br />
        > 関連する画面・機能に対するデータモデルを設計します。<br />
        > 以降の工程をAI自動化するために必要な手順です。

        ### 入力
        - 画面・機能
        - 顧客文書(データ構造資料)

        ### エンジニアによる処理
        - データの名称(例えばCustomer、Employee)
          - フィールドの詳細
            - 上限値・下限値
            - 最大長
            - NULL許容などを定める
          - 論理削除型 or 物理削除型
          - リレーションとカスケード削除
      ||
      assist: {
        class: assist
        label: ""
        description: ||md
          **担当**: エンジニア + DBアーキテクトAI(支援)
          ### 処理
          - エンジニア主導の設計対話を AI が支援
          - 命名・整合性・抜け漏れの指摘
          - 既存ドメインモデルとの突き合わせ
          ### 出力
          - **テーブル仕様** (フィールド・制約・リレーション)
        ||
      }
    }

  }

  data-model-impl: {
    class: task
    label: ""
    description: ||md
      ## データモデル実装
      > 設計成果(テーブル仕様)を受けて **AI駆動** で実装します。

      ### 入力
      - テーブル仕様
    ||
    output {
      class: sdd
      label: ""
      description: ||md
        **担当**: DBアーキテクトAI
        ### 処理
        - schema.prisma を生成
        - マイグレーションを生成
        - インデックス・カスケード設定の反映
        ### 出力
        - **schema.prisma** (仕様 = 実装)
        - DBマイグレーション
      ||
    }
  }

  data-model-bulk: {
    class: task
    label: ""
    description: ||md
      ## データモデル一括生成 (ショートカット)
      > データ構造資料が十分に整理されている場合に選択。<br />
      > 設計工程を飛ばして DBアーキテクトAI が直接実装まで進めます。

      ### 入力
      - データ構造資料 (整理済み)

      ### 適用条件
      - フィールド・型・制約・リレーションが明示されている
      - 命名規則が一貫している
      - 論理/物理削除や NULL 許容方針が判別できる
    ||
    output {
      class: sdd
      label: ""
      description: ||md
        **担当**: DBアーキテクトAI
        ### 処理
        - 資料からテーブル定義を一括抽出
        - schema.prisma を一括生成
        - マイグレーションを一括生成
        ### 出力
        - **schema.prisma** (仕様 = 実装)
        - DBマイグレーション
      ||
    }
  }

  design.ux -> frontend.design
  parent-tasks.task -> design.ux: "画面・機能"
  parent-tasks.task -> design.data-model-design: "画面・機能"

  design.data-model-design -> data-model-impl: "テーブル仕様"
  requirements.agreement.excel -> data-model-bulk: "整理済み資料"
  data-model-impl -> api: "schema.prisma"
  api -> frontend.design: "API、DTO"

  api: {
    class: task
    label: ""
    description: ||md
      ## API設計・実装
      DTO・GraphQLスキーマ・API・テストを一括で生成する
      ### 入力
      - schema.prisma
      - 機能仕様(画面・機能)
    ||
    sdd: {
      label: ""
      class: sdd
      description: ||md
        **担当**: バックエンドAI → バックエンドレビュワーAI → テスターAI
        ### 処理
        - バックエンドAI: API設計・実装、DTO/GraphQLスキーマ生成
        - バックエンドレビュワーAI: コードレビュー・修正提案
        - テスターAI: 統合テスト追加
        ### 出力
        - **DTO・バリデーション** (Zod等)
        - **GraphQLスキーマ**
        - リゾルバー・サービスの実装
        - ユニットテスト + 統合テスト
      ||
    }
  }

  api-bulk: {
    class: task
    label: ""
    description: ||md
      ## API一括実装 (ショートカット)
      > API・認証認可資料が十分に整理されている場合に選択。<br />
      > 設計工程を飛ばして バックエンドAI が直接実装まで進めます。

      ### 入力
      - API・認証認可資料 (整理済み)
      - schema.prisma

      ### 適用条件
      - エンドポイント・パラメータ・レスポンスが明示されている
      - 認証認可方針が決まっている
      - エラー応答・ステータスコードが判別できる
    ||
    sdd: {
      label: ""
      class: sdd
      description: ||md
        **担当**: バックエンドAI → バックエンドレビュワーAI → テスターAI
        ### 処理
        - バックエンドAI: 資料からエンドポイントを一括抽出 → DTO/GraphQL/実装を一括生成
        - バックエンドレビュワーAI: コードレビュー・修正提案
        - テスターAI: 統合テスト追加
        ### 出力
        - **DTO・バリデーション** (Zod等)
        - **GraphQLスキーマ**
        - リゾルバー・サービスの実装
        - ユニットテスト + 統合テスト
      ||
    }
  }

  data-model-bulk -> api-bulk: "schema.prisma"
  api-bulk -> frontend.design: "API、DTO"

  frontend {
    class: dash
    design: {
      class: task
      label: ""
      description: ||md
        ## フロントエンド設計
        ### 入力
        - API + DTO (バックエンドAIの出力)
        - UX設計図
      ||
      sdd: {
        label: ""
        class: sdd
        description: ||md
          **担当**: フロントエンドAI
          ### 処理
          - 画面側表示・処理設計
          - 画面から呼び出すAPIの選定
          - サーバー側処理(SSR等)の設計
          ### 出力
          - 画面実装設計
        ||
      }
    }
    component: {
      class: task
      label: ""
      description: ||md
        ## コンポーネント設計・実装
        ### 入力
        - DTO(一部)
        - 機能
      ||
      sdd: {
        label: ""
        class: sdd
        description: ||md
          **担当**: フロントエンドAI
          ### 処理
          - パラメーター設計
          - 機能設計・実装
          ### 出力
          - 実装済みコンポーネント
        ||
      }
    }
    design -> component: "DTO(一部)、機能(一部)"
    design -> implementation: "DTO、API"
    component -> implementation: "コンポーネント"
    implementation: {
      class: task
      label: ""
      description: ||md
        ## フロントエンド実装
        ### 入力
        - 画面実装設計
        - 実装済みコンポーネント
        - API + DTO
      ||
      sdd: {
        label: ""
        class: sdd
        description: ||md
          **担当**: フロントエンドAI → テスターAI
          ### 処理
          - フロントエンドAI: 画面の組み立て・API連携・状態管理
          - テスターAI: E2Eテスト生成・実行
          ### 出力
          - 画面実装結果
          - E2Eテスト
        ||
      }
    }
  }
}

