classes {
  blank: {
    label: ""
    style: {
      fill: white
      stroke-width: 0
    }
  }
  dash: {
    label: ""
    style: {
      fill: white
      stroke-dash: 2
      stroke-width: 2
    }
  }
  task: {
    icon: "./images/list-check-solid-full.svg"
    icon.near: top-right
    style: {
      fill: white
    }
    grid-rows: 2
    grid-gap: 8
  }
  sdd: {
    icon: "./images/claudecode-color.svg"
    icon.near: top-left
    style: {
      fill: "#ddffdd"
    }
  }
  assist: {
    icon: "./images/claudecode-color.svg"
    icon.near: top-left
    style: {
      fill: "#fff4dd"
      stroke-dash: 3
    }
  }
  agent: {
    icon: "./images/claudecode-color.svg"
    icon.near: top-left
    style: {
      fill: "#e6f0ff"
    }
  }
  plan-agent: {
    icon: "./images/claudecode-color.svg"
    icon.near: top-left
    style: {
      fill: "#fff4dd"
    }
  }
}

grid-columns: 2

grid {
  grid-rows: 4
  class: blank

  agenda: {
    label: ""
    description: ||md
      ## このフローの要点
      - 要件定義・変更管理などは従来のやり方を踏襲する
      - **プランニング** と **実装オーケストレーション** で段階的にAIの力を借りる
      - **プランニング** では、実装に必要な情報は全てタスク上に集約する
      - **実装オーケストレーション** はタスクを真実の情報源として、複数の専門AIが連鎖的に処理を行う
      - AIでうまくいかないところはエンジニアが補完する
    ||
  }

  pm: {
    label: ""
    description: ||md
      ## プロジェクト管理者の視点
      - プロジェクト管理の方法は変化しません。
      - 従来通りBacklog等のタスクのWBSの状況がそのままの進捗状況となります。
      - 初期のタスクはプランナーAIが起票します。
      - 変更管理のタスクはエンジニアが起票します。
    ||
  }

  legend: {
    label: "凡例"
    style {
      fill: white
    }
    task: {
      class: task
      label: ""
      description: ||md
        ## タスク
      ||
      sdd: {
        class: sdd
        label: "AI駆動で実装する範囲\n(spec駆動開発)"
      }
      assist: {
        class: assist
        label: "AI支援で実装する範囲\n(エンジニア主導)"
      }
    }
  }

  agents: {
    label: "AIエージェント群"
    grid-rows: 4
    grid-columns: 2
    grid-gap: 16

    planner: {
      label: "プランナーAI"
      class: plan-agent
      description: ||md
        **役割**: タスク・チケット管理
        ### 入力
        - アーキテクトAIの分析結果
        ### 出力
        - チケットの起票
        - チケットの更新
      ||
    }

    architect: {
      label: "アーキテクトAI"
      class: plan-agent
      description: ||md
        **役割**: 実装検討・責務分析
        ### 入力
        - 要件・仕様(顧客文書/内部文書)
        - 既存実装の構造
        ### 出力
        - 画面・機能の **責務分析**
        - **実装範囲・影響範囲** の整理
        - ドメインモデル整合チェック結果
      ||
    }

    orchestrator: {
      label: "オーケストレーターAI"
      class: agent
      description: ||md
        **役割**: 実行指揮・連鎖実行
        ### 入力
        - 親タスク(Backlog)
        ### 出力
        - 作業計画
        - 専門AI への連鎖呼び出し
        ### 介入ポイント
        - エラー時のみエンジニアへ報告 (リトライ/差戻しは事前ルール)
      ||
    }

    db-architect: {
      label: "DBアーキテクトAI"
      class: agent
      description: ||md
        ### 入力
        - テーブル仕様(データ名・フィールド・制約・リレーション)
        ### 出力
        - **schema.prisma**
        - DBマイグレーション
        - インデックス・カスケード設計
      ||
    }

    backend: {
      label: "バックエンドAI"
      class: agent
      description: ||md
        ### 入力
        - schema.prisma
        - 機能仕様(画面・機能から導かれるAPI要求)
        ### 出力
        - **DTO・バリデーション**(Zod等)
        - **GraphQLスキーマ**
        - API実装(リゾルバー・サービス層)
        - ユニットテストコード
      ||
    }

    backend-reviewer: {
      label: "バックエンドレビュワーAI"
      class: agent
      description: ||md
        ### 入力
        - バックエンドAIの実装コード
        - 仕様(DTO・API仕様)
        ### 出力
        - レビュー指摘・修正提案
        - セキュリティ・性能観点の警告
      ||
    }

    frontend: {
      label: "フロントエンドAI"
      class: agent
      description: ||md
        ### 入力
        - **API**(バックエンドAIの出力)
        - **画面仕様**(UX設計図)
        ### 出力
        - 画面実装(ページ・コンポーネント)
        - API連携・状態管理処理
      ||
    }

    tester: {
      label: "テスターAI"
      class: agent
      description: ||md
        ### 入力
        - 仕様(API・画面)
        - 実装コード
        ### 出力
        - テストコード(統合・E2E)
        - 実行結果・不具合レポート
      ||
    }
  }

  operations: {
    label: "運用パターン (skill / コマンド化)"
    grid-rows: 2
    grid-gap: 12

    planning-skill: {
      shape: page
      label: "プランニングスキル"
      style.fill: "#fff8e1"
      description: ||md
        ### 内部フロー
        - アーキテクトAIによる仕様分析
        - プランナーAIによるタスク起票・更新
      ||
    }

    implementation-skill: {
      shape: page
      label: "実装オーケストレーション"
      style.fill: "#e3f2fd"
      description: ||md
        ### 内部フロー (orchestrator が司令)
        1. **orchestrator** が親タスクから全体への指示を作成
        2. **db-architect** → schema.prisma 更新
        3. **backend** → DTO/GraphQL/API 実装 (schema.prisma 参照)
        4. **backend-reviewer** → 直前変更レビュー
        5. **frontend** → 画面実装 (DTO 参照)
        6. **tester** → 統合・E2E テスト
        7. plan.md の進捗チェックを順次更新
        8. 完了で **PR ドラフト作成** (description は plan.md から生成)
        9. PR merge を契機に Backlog 親タスクを自動 close
      ||
    }
  }
}

develop {
  class: blank

  requirements {
    label: "要件一覧・仕様一覧"
    agreement {
      class: dash
      label: "開発初期にお客様と合意したもの"
      initial-docs: {
        label: "初期資料"
        excel {
          class: blank
          label: "データ構造資料"
          icon: "https://res-1.cdn.office.net/files/fabric-cdn-prod_20251008.001/assets/brand-icons/product/svg/excel_48x1.svg"
        }
        power-point {
          class: blank
          label: "ラフスケッチ"
          icon: "https://res-1.cdn.office.net/files/fabric-cdn-prod_20251008.001/assets/brand-icons/product/svg/powerpoint_48x1.svg"
        }
        design {
          class: blank
          label: "機能一覧"
          icon: "https://res-1.cdn.office.net/files/fabric-cdn-prod_20251008.001/assets/brand-icons/product/svg/excel_48x1.svg"
        }
      }
    }
    requirement: {
      grid-columns: 3
      label: "内部文書"
      backlog: {
        label: "ticket"
        shape: image
        icon: "https://backlog.com/app/themes/backlog-child/assets/img/common/logo/logo_backlog.svg"
      }
      markdown: {
        label: "wiki, README等"
        shape: image
        icon: "./images/markdown-brands-solid-full.svg"
      }
      github: {
        label: "issue, source code"
        shape: image
        icon: "./images/github-brands-solid-full.svg"
      }
      api {
        label: "API・認証認可資料"
        shape: image
        icon: "https://res-1.cdn.office.net/files/fabric-cdn-prod_20251008.001/assets/brand-icons/product/svg/excel_48x1.svg"
      }
      environment: ||md
      ## エンジニアが事前考慮した情報群
      - 開発環境
        - フレームワーク
        - 言語
      - 運用環境
        - インフラ
        - セキュリティ
      ||
    }
    change: {
      label: "仕様変更・追加要件"
      class: dash
      management: {
        label: "変更管理文書"
        shape: image
        icon: "https://res-1.cdn.office.net/files/fabric-cdn-prod_20251008.001/assets/brand-icons/product/svg/excel_48x1.svg"
      }
    }
    bug-fix: {
      label: "不具合対応"
      class: dash
      management: {
        label: "不具合修正チケット"
        shape: image
        icon: "https://backlog.com/app/themes/backlog-child/assets/img/common/logo/logo_backlog.svg"
      }
    }
  }

  parent-tasks {
    label: "親タスク群"
    icon: "https://backlog.com/app/themes/backlog-child/assets/img/common/logo/logo_backlog.svg"
    icon.near: top-left

    note: {
      class: blank
      description: ||md
        ## タスクの区切り方と消化の仕方
        - **1画面・1機能 ≒ 1親タスク** (Backlog 起票)
        - **1親タスク = 1 PR** (実装完了の粒度)
        ## タスクに含まれる情報
        - 画面上の表示項目
        - 画面上の操作
        - API で扱うデータの内容
        - ゴール(タスクの終了条件)
      ||
    }

    task: {
      label: "spec駆動タスク"
      class: task
      style.multiple: true
      ai-planning: {
        class: sdd
        label: "要件・仕様の分析"
        description: ||md
          **担当**: アーキテクトAI + プランナーAI<br />

          ### 流れ (ファイル媒介の順次実行)
          - **アーキテクトAI**: 要件読解 → 責務分析 → 整合チェック → 技術選定
          - **プランナーAI**: 親タスク提案 → エンジニア承認 → Backlog 起票
          ### 出力
          - **Backlog 親タスク群** (1画面・1機能 = 1タスク = 1 PR)
          - タスクには画面・機能の仕様と実装範囲を記述 (AI分析結果を反映)
        ||
      }
    }

    change-task: {
      label: "変更対応タスク(改修・追加要件) / 手動タスク"
      class: task
      style.multiple: true
      description: ||md
        ## 変更対応タスク
        **アーキテクトAI**と**プランナーAI**をアシスタントとしてタスクを起票
      ||
      assist: {
        label: ""
        class: assist
        description: ||md
          ## 出力
          - タスクには画面・機能の仕様と実装範囲を記述
        ||
      }
    }

    task -> change-task: "AIではタスクがうまく切れなかった部分"
  }

  requirements.agreement.initial-docs -> parent-tasks: "初期要件・仕様"
  requirements.requirement -> parent-tasks: 参照
  requirements.change.management -> parent-tasks.change-task: "仕様変更"
  requirements.bug-fix -> parent-tasks.change-task: "不具合対応"

  ux: {
    label: ""
    class: task
    description: ||md
      ## UX設計
      > モックアップが済んでいる場合、このタスクはスキップします。

      ### 入力
      - プランニング時のタスク仕様
      - 画面・機能・要件からアーキテクトAIの分析結果
      ### エンジニアによる処理
      - AI / エンジニアが作るべきものの仕様書を記述
      ### 出力
      - UX設計図
      - 画面が扱う情報のまとめ
    ||
    sdd: {
      label: "フロントエンドAI"
      class: sdd
    }
    assist: {
      class: assist
      label: "複雑な部分\n\nエンジニア主導\nフロントエンドAI"
    }
  }

  data-model-design: {
    class: task
    label: ""
    sdd: {
      class: sdd
      label: ""
      description: ||md
        **担当**: DBアーキテクトAI
        ### 入力
        - タスク（機能仕様）
        ### 処理
        - 画面・機能から必要なデータを洗い出し、テーブル設計を行う
        - 既存テーブルとのリレーションや整合性も考慮する
        ### 出力
        - **テーブル仕様** (フィールド・制約・リレーション)
      ||
    }
    assist: {
      class: assist
      label: "複雑な部分\n\nエンジニア主導\nDBアーキテクトAI"
    }
  }

  frontend-design: {
    class: task
    label: "フロントエンド設計"
    sdd: {
      label: "フロントエンドAI"
      class: sdd
    }
    assist: {
      class: assist
      label: "複雑な部分\n\nエンジニア主導\nフロントエンドAI"
    }
  }

  data-model-impl: {
    class: task
    label: "データモデル生成"
    output {
      class: sdd
      label: "DBアーキテクトAI"
    }
  }

  api-impl: {
    class: task
    label: "API設計・実装(改修)"
    sdd: {
      class: sdd
      label: "CRUD・単純API\n\nバックエンドAI\nバックエンドレビュワーAI"
    }
    assist: {
      class: assist
      label: "複雑なビジネスロジック\n\nエンジニア主導\nバックエンドAI\nバックエンドレビュワーAI"
    }
  }

  data-model-impl -> api-impl: "schema-prisma"

  parent-tasks -> data-model-design: "テーブル仕様(オーケストレーターAIが必要情報を抽出)"
  parent-tasks -> ux: "機能仕様(オーケストレーターAIが必要情報を抽出)"

  ux -> frontend-design: "画面仕様(詳細)"
  data-model-design -> data-model-impl: "テーブル仕様"
  api-impl -> frontend-design: "API、DTO"
  frontend-design -> frontend: "API、DTO、画面仕様(詳細)"

  frontend {
    class: dash
    label: "フロントエンド実装"
    component: {
      class: task
      label: "コンポーネント実装"
      sdd: {
        label: "フロントエンドAI"
        class: sdd
      }
      assist: {
        class: assist
        label: "複雑な部分\n\nエンジニア主導\nフロントエンドAI"
      }
    }
    implementation: {
      class: task
      label: "フロントエンド実装"
      sdd: {
        label: "フロントエンドAI"
        class: sdd
      }
      assist: {
        class: assist
        label: "複雑な部分\n\nエンジニア主導\nフロントエンドAI"
      }
    }
  }

  instruction-examples: {
    label: "専門AIへの指示書例 (変更対応シナリオ: Customerテーブルに電話番号を追加)"
    grid-columns: 5
    grid-gap: 12

    to-db-architect: {
      shape: page
      label: "→ DBアーキテクトAI"
      style.fill: "#f5f5f5"
      description: ||md
        ## 依頼
        Customer テーブルに `phoneNumber` を追加
        ## 仕様
        - 型: String / NULL 許容
        - 既存行は NULL のまま
        ## 出力
        - schema.prisma 更新
        - マイグレーション
      ||
    }

    to-backend: {
      shape: page
      label: "→ バックエンドAI"
      style.fill: "#f5f5f5"
      description: ||md
        ## 依頼
        Customer 取得APIに `phoneNumber` を含める
        ## 仕様
        - CustomerDto に phoneNumber: string \| null
        - GraphQL スキーマ更新
        - サービス層は変更不要
      ||
    }

    to-backend-reviewer: {
      shape: page
      label: "→ バックエンドレビュワーAI"
      style.fill: "#f5f5f5"
      description: ||md
        ## 依頼
        直前の変更をレビュー
        (phoneNumber 追加, nullable)
      ||
    }

    to-frontend: {
      shape: page
      label: "→ フロントエンドAI"
      style.fill: "#f5f5f5"
      description: ||md
        ## 依頼
        顧客詳細画面に電話番号を表示
        ## 仕様
        - NULL の場合「未登録」と表示
        - 既存レイアウトを崩さない
        - 編集UIは今回対象外
      ||
    }

    to-tester: {
      shape: page
      label: "→ テスターAI"
      style.fill: "#f5f5f5"
      description: ||md
        ## テスト対象
        Customer 取得APIと顧客詳細画面
        ## 観点
        - phoneNumber の値あり/NULL
        - 既存のCustomer取得テスト維持
        - スナップショット更新
      ||
    }
  }
}

